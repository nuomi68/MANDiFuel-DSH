# Copy to launcher.env and replace the absolute path placeholders.
# Keep credentials out of this file. Preserve virtualenv Python entry paths.
MANDIFUEL_OPENFOAM_BASHRC='/absolute/path/to/OpenFOAM-v2506/etc/bashrc'
MANDIFUEL_OFFBEAT_BIN='/absolute/path/to/offbeat/bin'
MANDIFUEL_BASE_PYTHON='/absolute/path/to/python-env/bin/python3.12'
MANDIFUEL_DSH='/absolute/path/to/dsh'
MANDIFUEL_NODE='/absolute/path/to/node'
MANDIFUEL_CASE_LIBRARY_ROOT='/absolute/path/to/offbeat-source'

# Online RAG configuration: names of environment variables, never key values.
MANDIFUEL_RAG_MAPPING_BASE_URL='https://api.deepseek.com'
MANDIFUEL_RAG_MAPPING_MODEL='deepseek-chat'
MANDIFUEL_RAG_MAPPING_API_KEY_ENV='DEEPSEEK_API_KEY'
MANDIFUEL_RAG_EMBEDDING_BASE_URL='https://dashscope.aliyuncs.com/compatible-mode/v1'
MANDIFUEL_RAG_EMBEDDING_MODEL='text-embedding-v3'
MANDIFUEL_RAG_EMBEDDING_DIMENSION='1024'
MANDIFUEL_RAG_EMBEDDING_API_KEY_ENV='DASHSCOPE_API_KEY'
# Optional override. Defaults to .cache/rag under this plugin's installation directory.
# MANDIFUEL_RAG_CACHE_DIR='/absolute/path/to/rag-cache'
MANDIFUEL_RAG_TIMEOUT_SECONDS='120'
